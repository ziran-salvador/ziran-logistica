rules_version = '2';
// Regras de segurança do banco — Ziran Logística
// Copie TODO este conteúdo para: Firebase Console › Firestore Database › Regras › Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && eu().status == 'ativo';
    }
    function admin() { return ativo() && eu().perfil == 'admin'; }

    // Cadastro de usuários
    match /users/{uid} {
      // cada um lê o próprio cadastro; o administrador lê todos
      allow read: if (logado() && request.auth.uid == uid) || admin();
      // quem se cadastra entra sempre como operador PENDENTE (precisa de aprovação)
      allow create: if admin() || (
        logado() && request.auth.uid == uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.perfil == 'operador'
        && request.resource.data.email == request.auth.token.email
      );
      // só o administrador muda perfil/situação; o próprio usuário só atualiza nome e último acesso
      allow update: if admin() || (
        logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'ultimoAcesso'])
      );
      allow delete: if admin();
    }

    // Dados operacionais: qualquer usuário ATIVO lê e grava
    match /bookings/{id}   { allow read, write: if ativo(); }
    match /containers/{id} { allow read, write: if ativo(); }
    match /ots/{id}        { allow read, write: if ativo(); }
    match /lotes/{id}      { allow read, write: if ativo(); }
    match /ops/{id}        { allow read, write: if ativo(); }
    match /meta/{id}       { allow read, write: if ativo(); }

    // Histórico: só pode ser acrescentado; apagar apenas o administrador
    match /log/{id} {
      allow read, create: if ativo();
      allow update: if false;
      allow delete: if admin();
    }
  }
}
